function init(self)
	msg.post(".", "acquire_input_focus")
	self.logs = 0
	self.total = 6
	self.found = {}
	msg.post("/hud#hud", "show_dialogue", { text = "Welcome to the Moon! Find 6 discarded equipment. Walk to them." })
end

