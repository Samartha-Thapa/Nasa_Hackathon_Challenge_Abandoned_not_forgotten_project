go.property("building_type", hash("solar"))

function init(self)
	print("BUILDING INIT type=", self.building_type)
	sprite.play_flipbook("#sprite", self.building_type, nil, { playback = go.PLAYBACK_NONE })
	go.set_scale(vmath.vector3(0.18, 0.18, 1))
end

