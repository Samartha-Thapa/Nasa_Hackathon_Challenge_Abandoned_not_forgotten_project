function on_message(self, message_id, message, sender)
	if message_id == hash("trigger_response") then
		if message.enter then
			-- send my real position, not a guessed one
			local my_pos = go.get_world_position()
			msg.post("/build_controller", "player_entered_lot", { lot = self.lot_index, pos = my_pos })
		else
			msg.post("/build_controller", "player_left_lot", { lot = self.lot_index })
			msg.post("/hud#hud", "hide_dialogue")
		end
	end
end

