local CATEGORIES = {
	buildings = {
		{ key = "solar", name = "Solar Panel Farm", cost = 100, icon = "solar" },
		{ key = "research", name = "Research Base", cost = 150, icon = "research" },
		{ key = "museum", name = "Museum", cost = 200, icon = "museum" },
		{ key = "rocket", name = "Launch Rocket", cost = 500, icon = "rocket" },
	},
	resources = {
		{ key = "ship_1", name = "Scout Shuttle", cost = 300, icon = "Type_1" },
		{ key = "ship_2", name = "Cargo Lander", cost = 450, icon = "Type_2" },
		{ key = "ship_3", name = "Orbital Relay", cost = 600, icon = "Type_3" },
	},
	upgrades = {
		{ key = "upgrade", name = "Lot Upgrade", cost = 250, icon = "research_icon" },
		{ key = "rocket", name = "Launch Systems", cost = 500, icon = "rocket" },
		{ key = "research", name = "Research Network", cost = 350, icon = "research_icon" },
	},
}

local function enabled(self, id, value)
	gui.set_enabled(gui.get_node(id), value)
end

local function set_category(self, category)
	if self.category ~= category then
		self.card_index = 1
	end
	self.category = category
	local items = CATEGORIES[category]
	local item = items[self.card_index]
	for index = 1, 4 do
		if index ~= 1 or not item then
			enabled(self, "card" .. index .. "_fill", false)
			enabled(self, "card" .. index, false)
			enabled(self, "card" .. index .. "_icon", false)
			enabled(self, "card" .. index .. "_name", false)
			enabled(self, "card" .. index .. "_cost", false)
			enabled(self, "buy" .. index, false)
			enabled(self, "buy" .. index .. "_text", false)
		else
		gui.set_text(gui.get_node("card" .. index .. "_name"), item.name)
		gui.set_text(gui.get_node("card" .. index .. "_cost"), item.cost .. " coins")
		gui.play_flipbook(gui.get_node("card" .. index .. "_icon"), item.icon)
		gui.set_text(gui.get_node("buy" .. index .. "_text"),
			category == "buildings" and "BUILD" or "BUY")
		enabled(self, "card" .. index, true)
		enabled(self, "card" .. index .. "_fill", true)
		enabled(self, "card" .. index .. "_icon", true)
		enabled(self, "card" .. index .. "_name", true)
		enabled(self, "card" .. index .. "_cost", true)
		enabled(self, "buy" .. index, true)
		enabled(self, "buy" .. index .. "_text", true)
		end
	end
	gui.set_text(gui.get_node("store_page"), self.card_index .. " / " .. #items)
	gui.set_enabled(gui.get_node("prev"), #items > 1)
	gui.set_enabled(gui.get_node("next"), #items > 1)
	gui.set_color(gui.get_node("tab_buildings"),
		category == "buildings" and vmath.vector4(1, 0.8, 0.3, 1) or vmath.vector4(1, 1, 1, 1))
	gui.set_color(gui.get_node("tab_resources"),
		category == "resources" and vmath.vector4(1, 0.8, 0.3, 1) or vmath.vector4(1, 1, 1, 1))
	gui.set_color(gui.get_node("tab_upgrades"),
		category == "upgrades" and vmath.vector4(1, 0.8, 0.3, 1) or vmath.vector4(1, 1, 1, 1))
end

local function hide_store(self)
	self.open = false
	msg.post("/player", "set_can_move", { enabled = true })
	enabled(self, "store_scrim", false)
	enabled(self, "store_panel_fill", false)
	enabled(self, "store_panel", false)
	enabled(self, "store_title_bg", false)
	enabled(self, "store_title", false)
	enabled(self, "coin_icon", false)
	enabled(self, "money_value", false)
	enabled(self, "research_icon", false)
	enabled(self, "science_value", false)
	enabled(self, "close", false)
	enabled(self, "store_status", false)
	enabled(self, "store_page", false)
	enabled(self, "prev", false)
	enabled(self, "next", false)
	enabled(self, "prev_text", false)
	enabled(self, "next_text", false)
	enabled(self, "tab_buildings", false)
	enabled(self, "tab_resources", false)
	enabled(self, "tab_upgrades", false)
	for index = 1, 4 do
		enabled(self, "card" .. index .. "_fill", false)
		enabled(self, "card" .. index, false)
		enabled(self, "card" .. index .. "_icon", false)
		enabled(self, "card" .. index .. "_name", false)
		enabled(self, "card" .. index .. "_cost", false)
		enabled(self, "buy" .. index, false)
		enabled(self, "buy" .. index .. "_text", false)
	end
end

local function open_store(self, message)
	self.open = true
	msg.post("/player", "set_can_move", { enabled = false })
	self.lot = message.lot
	enabled(self, "store_scrim", true)
	enabled(self, "store_panel_fill", true)
	enabled(self, "store_panel", true)
	enabled(self, "store_title_bg", true)
	enabled(self, "store_title", true)
	enabled(self, "coin_icon", true)
	enabled(self, "money_value", true)
	enabled(self, "research_icon", true)
	enabled(self, "science_value", true)
	enabled(self, "close", true)
	enabled(self, "store_status", true)
	enabled(self, "store_page", true)
	enabled(self, "tab_buildings", true)
	enabled(self, "tab_resources", true)
	enabled(self, "tab_upgrades", true)
	gui.set_enabled(gui.get_node("prev_text"), true)
	gui.set_enabled(gui.get_node("next_text"), true)
	gui.set_text(gui.get_node("money_value"), math.floor(message.money))
	gui.set_text(gui.get_node("science_value"), math.floor(message.science))
	gui.set_text(gui.get_node("store_status"), "Select an item to prepare the outpost.")
	set_category(self, "buildings")
end

function init(self)
	msg.post(".", "acquire_input_focus")
	self.open = false
	self.category = "buildings"
	self.card_index = 1
	self.touch_start_x = nil
	self.bounce_time = 0
	hide_store(self)
end

function update(self, dt)
	if not self.open then return end
	self.bounce_time = self.bounce_time + dt
	local bounce_phase = self.bounce_time % 6.0
	local pulse = 1
	if bounce_phase < 0.8 then
		pulse = 1 + math.sin(bounce_phase * math.pi / 0.8) * 0.08
	end
	gui.set_scale(gui.get_node("coin_icon"), vmath.vector3(pulse, pulse, 1))
end

function on_message(self, message_id, message)
	if message_id == hash("open_store") then
		open_store(self, message)
	elseif message_id == hash("close_store") then
		hide_store(self)
	elseif message_id == hash("store_state") then
		gui.set_text(gui.get_node("money_value"), math.floor(message.money))
		gui.set_text(gui.get_node("science_value"), math.floor(message.science))
	elseif message_id == hash("store_result") then
		gui.set_text(gui.get_node("store_status"), message.text)
		if message.money then
			gui.set_text(gui.get_node("money_value"), math.floor(message.money))
		end
	end
end

function on_input(self, action_id, action)
	if not self.open then return end
	if action_id == hash("interact") then
		if not action.pressed then return end
		hide_store(self)
		msg.post("/build_controller", "close_store")
		return
	end
	if action_id ~= hash("touch") then return end
	local x, y = action.x, action.y
	if action.pressed then
		self.touch_start_x = x
		return
	end
	if not action.released then return end
	local start_x = self.touch_start_x or x
	local delta_x = x - start_x
	if math.abs(delta_x) > 80 and y > 180 and y < 470 then
		local count = #CATEGORIES[self.category]
		if delta_x < 0 then
			self.card_index = math.min(self.card_index + 1, count)
		else
			self.card_index = math.max(self.card_index - 1, 1)
		end
		set_category(self, self.category)
		return
	end
	if x > 1110 and y > 590 then
		hide_store(self)
		msg.post("/build_controller", "close_store")
	elseif y > 515 and y < 570 then
		if x < 500 then set_category(self, "buildings")
		elseif x < 780 then set_category(self, "resources")
		else set_category(self, "upgrades") end
	elseif y > 205 and y < 270 then
		local item = CATEGORIES[self.category][self.card_index]
		if item then
			msg.post("/build_controller", "store_purchase", { item = item.key, category = self.category })
		end
	elseif x > 240 and x < 355 and y > 285 and y < 390 then
		self.card_index = math.max(self.card_index - 1, 1)
		set_category(self, self.category)
	elseif x > 925 and x < 1040 and y > 285 and y < 390 then
		self.card_index = math.min(self.card_index + 1, #CATEGORIES[self.category])
		set_category(self, self.category)
	end
end
