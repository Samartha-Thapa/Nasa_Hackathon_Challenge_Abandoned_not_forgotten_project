local function get_node_safe(name)
	local ok, node = pcall(gui.get_node, name)
	if ok then
		return node
	end
	return nil
end

local function set_visible(name, visible)
	local node = get_node_safe(name)
	if node then
		gui.set_visible(node, visible)
	end
end

local function set_text(name, text)
	local node = get_node_safe(name)
	if node then
		gui.set_text(node, text)
	end
end

local function set_color(name, color)
	local node = get_node_safe(name)
	if node then
		gui.set_color(node, color)
	end
end

local function set_position(name, pos)
	local node = get_node_safe(name)
	if node then
		gui.set_position(node, pos)
	end
end

local function set_size(name, size)
	local node = get_node_safe(name)
	if node then
		gui.set_size(node, size)
	end
end

local function set_space_visible(visible)
	set_visible("space", visible)
	set_visible("stars_far", visible)
	set_visible("stars_near", visible)
	set_visible("asteroid_a", visible)
	set_visible("asteroid_b", visible)
	set_visible("moon", visible)
	set_visible("gas_giant", visible)
	set_visible("ice_planet", visible)
end

local function finish_opening(self)
	sound.stop("#typing_sound")
	self.finished = true
	msg.post("bootstrap:/loader#loader", "go_to_earth")
end

local function update_space_motion(self, dt)
	self.motion_time = self.motion_time + dt

	local stars_near = get_node_safe("stars_near")
	if stars_near then
		local stars_alpha = 0.88 + math.sin(self.motion_time * 1.7) * 0.08
		gui.set_color(stars_near, vmath.vector4(1, 1, 1, stars_alpha))
	end
	local stars_far = get_node_safe("stars_far")
	if stars_far then
		local far_alpha = 0.9 + math.sin(self.motion_time * 0.8 + 1.3) * 0.05
		gui.set_color(stars_far, vmath.vector4(1, 1, 1, far_alpha))
	end

	local moon = get_node_safe("moon")
	if moon then gui.set_rotation(moon, vmath.quat_rotation_z(self.motion_time * 0.04)) end
	local gas = get_node_safe("gas_giant")
	if gas then gui.set_rotation(gas, vmath.quat_rotation_z(self.motion_time * -0.02)) end
	local ice = get_node_safe("ice_planet")
	if ice then gui.set_rotation(ice, vmath.quat_rotation_z(self.motion_time * 0.06)) end

	for _, asteroid in ipairs(self.asteroids) do
		local node = get_node_safe(asteroid.id)
		if node then
			local position = gui.get_position(node)
			position.x = position.x + asteroid.velocity.x * dt
			position.y = position.y + asteroid.velocity.y * dt
			if position.x < -40 then position.x = 1320 end
			if position.x > 1320 then position.x = -40 end
			if position.y < 90 then position.y = 630 end
			if position.y > 630 then position.y = 90 end
			gui.set_position(node, position)
		end
	end
end

function init(self)
	msg.post(".", "acquire_input_focus")
	sound.play("#opening_sound")
	self.phase = 1
	self.timer = 0
	self.motion_time = 0
	self.finished = false
	self.typewriter_timer = 0
	self.briefing_text = ""
	self.base_motion_time = 0
	self.asteroids = {
		{ id = "asteroid_a", velocity = vmath.vector3(-9, 3, 0) },
		{ id = "asteroid_b", velocity = vmath.vector3(-5, -2, 0) }
	}

	set_space_visible(true)
	set_visible("earth", true)
	set_visible("earth_zoom", false)
	set_visible("base", false)
	set_visible("transition_fade", true)
	set_color("transition_fade", vmath.vector4(0, 0, 0, 0))
	set_visible("commander", false)
	set_visible("briefing_bg", false)
	set_visible("briefing_border", false)
	set_visible("briefing", false)
	set_visible("commander_name", false)
	set_visible("continue", false)
	set_position("earth", vmath.vector3(327, 360, 0))
	set_size("earth", vmath.vector3(200, 200, 0))
	set_position("asteroid_a", vmath.vector3(1186, 214, 0))
	set_position("asteroid_b", vmath.vector3(907, 529, 0))
	set_text("title", "DEEP SPACE // 2047")
	set_text("signal", "A silent signal is drifting home...")
end

function update(self, dt)
	if self.finished then
		return
	end

	self.timer = self.timer + dt
	update_space_motion(self, dt)

	if self.phase == 1 and self.timer >= 4.5 then
		self.phase = 2
		self.timer = 0
		local earth = get_node_safe("earth")
		if earth then
			gui.animate(earth, gui.PROP_POSITION, vmath.vector3(640, 360, 0), gui.EASING_INOUTSINE, 4.5)
			gui.animate(earth, gui.PROP_SIZE, vmath.vector3(560, 560, 0), gui.EASING_INOUTSINE, 4.5)
		end
		set_text("title", "EARTH // APPROACH VECTOR")
		set_text("signal", "Signal lock acquired. Surface habitat is still transmitting.")
	elseif self.phase == 2 and self.timer >= 4.5 then
		self.phase = 3
		self.timer = 0
		set_space_visible(false)
		set_visible("earth", false)
		set_visible("earth_zoom", false)
		set_color("transition_fade", vmath.vector4(0, 0, 0, 0.92))
		set_text("title", "SURFACE DESCENT")
		set_text("signal", "")
	elseif self.phase == 3 and self.timer >= 0.8 then
		self.phase = 4
		self.timer = 0
		set_visible("base", true)
		set_position("base", vmath.vector3(640, 360, 0))
		set_size("base", vmath.vector3(1280, 720, 0))
		set_color("base", vmath.vector4(1, 1, 1, 0))
		set_color("transition_fade", vmath.vector4(0, 0, 0, 0.92))
		local fade = get_node_safe("transition_fade")
		if fade then
			gui.animate(fade, gui.PROP_COLOR, vmath.vector4(0, 0, 0, 0), gui.EASING_INOUTSINE, 0.7, 0.25)
		end
		local base_node = get_node_safe("base")
		if base_node then
			gui.animate(base_node, gui.PROP_COLOR, vmath.vector4(1, 1, 1, 1), gui.EASING_INOUTSINE, 0.9)
		end
		set_text("title", "EARTH BASE // RESTORATION DIRECTIVE")
		set_text("signal", "Surface link established.")
	elseif self.phase == 4 and self.timer >= 1.8 then
		self.phase = 5
		self.timer = 0
		set_visible("commander", true)
		set_visible("briefing_bg", true)
		set_visible("briefing_border", true)
		set_visible("briefing", true)
		set_visible("commander_name", true)
		set_visible("continue", true)
		set_text("signal", "")
		set_text("commander_name", "Commander Hayes")
		self.briefing_text = "Cadet, the Earth outpost has been abandoned, not forgotten.\n"
		.."Rebuild the base, recover science, and reopen the routes to the Moon\n"
		.."and Mars."
		self.typewriter_timer = 0
		set_text("briefing", "")
		sound.play("#typing_sound")
	end

	if self.phase >= 4 then
		self.base_motion_time = self.base_motion_time + dt
		local base_position = vmath.vector3(
			640 + math.sin(self.base_motion_time * 0.22) * 3,
			360 + math.sin(self.base_motion_time * 0.17) * 2,
			0)
		set_position("base", base_position)
	end

	if self.phase == 5 and self.briefing_text ~= "" then
		self.typewriter_timer = self.typewriter_timer + dt
		local character_count = math.min(#self.briefing_text,
			math.floor(self.typewriter_timer * 42))
		set_text("briefing", string.sub(self.briefing_text, 1, character_count))
		if character_count >= #self.briefing_text then
			sound.stop("#typing_sound")
		end
	end
end

function on_input(self, action_id, action)
	if self.phase == 5 and action.pressed and
	(action_id == hash("interact") or action_id == hash("touch")) then
		finish_opening(self)
	end
end