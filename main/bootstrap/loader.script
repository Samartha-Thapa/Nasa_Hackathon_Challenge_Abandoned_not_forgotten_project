local PROXIES = {
	opening = "bootstrap:/loader#proxy_opening",
	earth = "bootstrap:/loader#proxy_earth",
	moon = "bootstrap:/loader#proxy_moon",
	-- mars removed for submission
}

local function switch_to(self, target)
	if self.pending == target then return end
	self.pending = target
	self.pending_timer = 0
	if self.current then
		-- SAME FOR EARTH AND MOON: disable + unload old world
		msg.post(PROXIES[self.current], "disable")
		msg.post(PROXIES[self.current], "unload")
	end
	-- SAME FOR EARTH AND MOON: load new world fresh, init() will run again
	msg.post(PROXIES[target], "load")
end

function init(self)
	msg.post(".", "acquire_input_focus")
	self.current = nil
	self.pending = "opening"
	self.pending_timer = 0
	msg.post(PROXIES.opening, "load")
end

function update(self, dt)
	if self.pending then
		self.pending_timer = self.pending_timer + dt
		if self.pending_timer > 0.8 then
			msg.post(PROXIES[self.pending], "enable")
			self.current = self.pending
			self.pending = nil
			self.pending_timer = 0
		end
	end
end

function on_input(self, action_id, action)
	if self.current ~= "opening" then return end
	if not action.pressed then return end
	if action_id == hash("interact") or action_id == hash("e") or action_id == hash("confirm") or action_id == hash("start") or action_id == hash("enter") or action_id == hash("space") then
		switch_to(self, "earth")
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("proxy_loaded") then
		if self.pending then
			msg.post(PROXIES[self.pending], "enable")
			self.current = self.pending
			self.pending = nil
			self.pending_timer = 0
		end
		return
	end

	if message_id == hash("go_to_opening") or message_id == hash("load_opening") then
		switch_to(self, "opening")
		return
	elseif message_id == hash("go_to_moon") or message_id == hash("load_moon") then
		switch_to(self, "moon")
		return
	elseif message_id == hash("go_to_earth") or message_id == hash("load_earth") or message_id == hash("return_to_earth") then
		switch_to(self, "earth")
		return
	end

	if self.current == "opening" or self.pending == "opening" then
		switch_to(self, "earth")
	end
end