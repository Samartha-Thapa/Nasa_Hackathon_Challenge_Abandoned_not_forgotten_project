go.property("equipment_id", hash("eagle"))

local STORIES = {
	apollo_11 = {
		title = "Apollo 11 - Eagle",
		text = "July 20, 1969. Eagle landed here. Neil Armstrong and Buzz Aldrin became the first humans to walk on the Moon. Eagle's descent stage is still here, abandoned, but not forgotten."
	},
	apollo_12 = {
		title = "Apollo 12",
		text = "November 1969. Pete Conrad and Alan Bean landed Apollo 12 just 163 meters from Surveyor 3. They walked over and cut pieces off Surveyor to bring home, so scientists could see how 2 years on the Moon changed it."
	},
	apollo_15_lrv = {
		title = "Apollo 15 - Lunar Rover",
		text = "July 1971. Apollo 15 left the first Lunar Roving Vehicle. 【entity-David Scott¦canonical_name=David Scott】 and James Irwin drove it 27 km across the Moon. It is still parked here, its batteries long dead, waiting for its drivers."
	},
	surveyor = {
		title = "Surveyor 3",
		text = "April 1967. Surveyor 3 was a robot. It landed softly, dug in the soil, and sent photos home. Two years later, Apollo 12 astronauts visited it. It was the first robot to be visited by humans on another world."
	},
	lunokhod = {
		title = "Lunokhod 1",
		text = "November 1970. The Soviet Union landed Lunokhod 1, the first rover to drive on another world. It drove 10 km over 10 months, then went silent. It waited 40 years before a laser found it again."
	},
	luna_2 = {
		title = "Luna 2",
		text = "September 1959. Luna 2 was the first human-made object to reach the Moon. It crashed here at 3.3 km per second, scattering small metal pennants. It never landed softly, but it got here first."
	},
}

function init(self)
	msg.post(".", "acquire_input_focus")
	self.player_near = false
	self.showing_story = false
	self.story = STORIES[self.equipment_id] or STORIES.apollo_11
end

local function show_dialogue(self, text)
	msg.post("/hud#hud", "show_dialogue", { text = text })
end

local function hide_dialogue(self)
	msg.post("/hud#hud", "hide_dialogue", {})
end

