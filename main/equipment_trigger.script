go.property("equipment_id", "apollo_11")

local STORIES = {
	apollo_11 = {
		title = "Apollo 11 - Eagle",
		year = "July 20, 1969",
		text = "July 20, 1969. Eagle landed here...",
		image = "apollo_11"
	},
	apollo_12 = {
		title = "Apollo 12",
		year = "November 1969",
		text = "November 1969. Pete Conrad...",
		image = "apollo_12"
	},
	apollo_15_lrv = {
		title = "Apollo 15 - Lunar Rover",
		year = "July 1971",
		text = "July 1971. Apollo 15 left...",
		image = "apollo_15_lrv"
	},
	surveyor = {
		title = "Surveyor 3",
		year = "April 1967",
		text = "April 1967. Surveyor 3 was...",
		image = "surveyor"
	},
	lunokhod = {
		title = "Lunokhod 1",
		year = "November 1970",
		text = "November 1970. The Soviet Union...",
		image = "lunokhod"
	},
	luna_2 = {
		title = "Luna 2",
		year = "September 1959",
		text = "September 1959. Luna 2 was...",
		image = "luna_2"
	},
}

function init(self)
	msg.post(".", "acquire_input_focus")
	self.player_near = false
	self.showing_story = false
	self.story = STORIES[self.equipment_id] or STORIES.apollo_11
end

local function show_dialogue(self, text)
	msg.post("/hud#hud", "show_dialogue", { text = text })
end

local function hide_dialogue(self)
	msg.post("/hud#hud", "hide_dialogue", {})
end

function final(self)
	-- Add finalization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function update(self, dt)
	-- Add update code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function late_update(self, dt)
	-- This function is called at the end of update cycle but before render
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function fixed_update(self, dt)
	-- This function is called if 'Fixed Update Frequency' is enabled in the Engine section of game.project
	-- Can be coupled with fixed updates of the physics simulation if 'Use Fixed Timestep' is enabled in
	-- Physics section of game.project
	-- Add update code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function on_message(self, message_id, message, sender)
	if message_id == hash("trigger_response") then
		if message.group == hash("player") then
			if message.enter then
				self.player_near = true
				if not self.showing_story then
					show_dialogue(self, "Press E - " .. self.story.title)
				end
			else
				self.player_near = false
				if self.showing_story then
					self.showing_story = false
					msg.post("/player", "set_can_move", { enabled = true })
					msg.post("/hud#hud", "hide_storybook", {})
				end
				hide_dialogue(self)
			end
		end
	end
end

function on_input(self, action_id, action)
	if not self.player_near then
		return
	end
	if action_id == hash("interact") and action.pressed then
		if not self.showing_story then
			msg.post("/hud#hud", "show_storybook", {
				id = self.equipment_id,
				title = self.story.title,
				year = self.story.year,
				text = self.story.text,
				image = self.story.image
			})
			self.showing_story = true
			msg.post("/player", "set_can_move", { enabled = false })
			hide_dialogue(self)
		else
			msg.post("/hud#hud", "hide_storybook", {})
			self.showing_story = false
			msg.post("/player", "set_can_move", { enabled = true })
			show_dialogue(self, "Press E - " .. self.story.title)
		end
	end
end

function on_reload(self)
	-- Add reload-handling code here
	-- Learn more: https://defold.com/manuals/hot-reload/
	-- Remove this function if not needed
end
