go.property("speed", 120)
go.property("is_moon", false)

function init(self)
	msg.post("#camera", "acquire_camera_focus")
	msg.post(".", "acquire_input_focus")
	self.left = false
	self.right = false
	self.up = false
	self.down = false
	self.current_animation = hash("idle")
	self.can_move = true
	self.camera_retry = 0
end

function update(self, dt)
	-- CAMERA FIX: retry every 0.5s, not once.
	self.camera_retry = self.camera_retry + dt
	if self.camera_retry > 0.5 then
		self.camera_retry = 0
		msg.post("#camera", "acquire_camera_focus")
		msg.post(".", "acquire_input_focus")
	end

	if not self.can_move then
		return
	end

	local dx = (self.right and 1 or 0) - (self.left and 1 or 0)
	local dy = (self.up and 1 or 0) - (self.down and 1 or 0)
	local length = math.sqrt(dx * dx + dy * dy)

	local animation = hash("idle")

	if length > 0 then
		-- move by speed, no collision
		local pos = go.get_position()
		pos.x = pos.x + (dx / length) * self.speed * dt
		pos.y = pos.y + (dy / length) * self.speed * dt
		go.set_position(pos)

		if dy > 0 then
			animation = hash("up")
		elseif dy < 0 then
			animation = hash("down")
		elseif dx < 0 then
			animation = hash("left")
		elseif dx > 0 then
			animation = hash("right")
		end
	end

	if animation ~= self.current_animation then
		sprite.play_flipbook("#sprite", animation)
		self.current_animation = animation
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("set_can_move") then
		self.can_move = message.enabled
		if not self.can_move then
			self.left = false
			self.right = false
			self.up = false
			self.down = false
		end

	elseif message_id == hash("teleport") then
		go.set_position(vmath.vector3(message.x, message.y, 0))
		self.can_move = true
		self.left = false
		self.right = false
		self.up = false
		self.down = false
		self.current_animation = hash("idle")
		sprite.play_flipbook("#sprite", hash("idle"))

	elseif message_id == hash("acquire_camera") or message_id == hash("enable") then
		msg.post("#camera", "acquire_camera_focus")
		msg.post(".", "acquire_input_focus")
	end
end

function on_input(self, action_id, action)
	if action_id == hash("interact") and action.pressed then
		if self.is_moon then
			msg.post("/moon_controller", "try_interact")
		else
			msg.post("/build_controller", "try_interact")
		end
		return
	end

	local pressed = action.pressed
	local released = action.released

	if action_id == hash("left") then
		if pressed then self.left = true end
		if released then self.left = false end
	elseif action_id == hash("right") then
		if pressed then self.right = true end
		if released then self.right = false end
	elseif action_id == hash("up") then
		if pressed then self.up = true end
		if released then self.up = false end
	elseif action_id == hash("down") then
		if pressed then self.down = true end
		if released then self.down = false end
	end
end