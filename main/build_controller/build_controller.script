go.property("start_money", 100)

local BUILDINGS = {
	solar = { name = "Solar Panel Farm", cost = 100, money = 5, science = 0, limit = 2 },
	research = { name = "Research Base", cost = 150, money = 0, science = 3, limit = 1 },
	museum = { name = "Museum", cost = 200, money = 3, science = 2, limit = 1 },
	rocket = { name = "Rocket", cost = 500, money = 0, science = 0, limit = 1 },
}

function init(self)
	msg.post(".", "acquire_input_focus")
	self.money = self.start_money
	self.science = 0
	self.timer = 0
	self.near_lot = nil
	self.menu_open = false
	self.counts = { solar = 0, research = 0, museum = 0, rocket = 0 }
	self.lots = {
		{ building = nil, level = 0, pos = nil, building_id = nil },
		{ building = nil, level = 0, pos = nil, building_id = nil },
		{ building = nil, level = 0, pos = nil, building_id = nil },
		{ building = nil, level = 0, pos = nil, building_id = nil },
		{ building = nil, level = 0, pos = nil, building_id = nil },
	}
	
end

function final(self)
	-- Add finalization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function update(self, dt)
	self.timer = self.timer + dt
	if self.timer >= 1 then
		self.timer = 0
		local money_gain = 2
		local science_gain = 0
		for _, lot in ipairs(self.lots) do
			if lot.building then
				local b = BUILDINGS[lot.building]
				money_gain = money_gain + b.money * lot.level
				science_gain = science_gain + b.science * lot.level
			end
		end
		self.money = self.money + money_gain
		self.science = self.science + science_gain
		msg.post("/hud#hud", "update_money", { money = math.floor(self.money), science = math.floor(self.science) })
	end
end

function late_update(self, dt)
	-- This function is called at the end of update cycle but before render
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function fixed_update(self, dt)
	-- This function is called if 'Fixed Update Frequency' is enabled in the Engine section of game.project
	-- Can be coupled with fixed updates of the physics simulation if 'Use Fixed Timestep' is enabled in
	-- Physics section of game.project
	-- Add update code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function on_message(self, message_id, message, sender)
	if message_id == hash("player_entered_lot") then
		self.near_lot = message.lot
		self.menu_open = false
		local lot = self.lots[self.near_lot]
		if message.pos then lot.pos = message.pos end
		print("ENTERED LOT", self.near_lot, "building=", lot.building)
		if lot.building == nil then
			msg.post("/hud#hud", "show_dialogue", { text = "Empty Lot " .. self.near_lot .. "! Press E to Build: [1] Solar 100 [2] Research 150 [3] Museum 200 [4] Rocket 500" })
		else
			local b = BUILDINGS[lot.building]
			msg.post("/hud#hud", "show_dialogue", { text = b.name .. " Lv." .. lot.level .. " on Lot " .. self.near_lot .. " - Press E to Upgrade" })
		end
		return
	elseif message_id == hash("player_left_lot") then
		self.near_lot = nil
		self.menu_open = false
		return
	elseif message_id == hash("try_interact") then
		if not self.near_lot then return end
		self.menu_open = true
		local lot = self.lots[self.near_lot]
		if lot.building == nil then
			msg.post("/hud#hud", "show_dialogue", { text = "CHOOSE: Press 1 Solar, 2 Research, 3 Museum, 4 Rocket" })
		else
			if lot.building == "rocket" then
				if self.money >= 500 and self.science >= 300 then
					self.money = self.money - 500
					self.science = self.science - 300
					msg.post("/hud#hud", "show_dialogue", { text = "3...2...1... ROCKET LAUNCHED! YOU WIN!" })
					msg.post("/player", "set_can_move", { enabled = false })
				else
					msg.post("/hud#hud", "show_dialogue", { text = "Need 500 Money + 300 Science to Launch! You have " .. math.floor(self.money) .. " / " .. math.floor(self.science) })
				end
			else
				local b = BUILDINGS[lot.building]
				local upgrade_cost = math.floor(b.cost * 1.5 * lot.level)
				if self.money >= upgrade_cost then
					self.money = self.money - upgrade_cost
					lot.level = lot.level + 1
					msg.post("/hud#hud", "show_dialogue", { text = b.name .. " upgraded to Lv." .. lot.level .. "!" })
					if lot.building_id then
						msg.post(lot.building_id, "upgrade", { level = lot.level })
					end
				else
					msg.post("/hud#hud", "show_dialogue", { text = "Need " .. upgrade_cost .. " coins to upgrade!" })
				end
			end
			self.menu_open = false
		end
	end
end

function on_input(self, action_id, action)
	if not self.menu_open then return end
	if not action.pressed then return end

	local choice = nil
	if action_id == hash("key_1") then choice = "solar"
	elseif action_id == hash("key_2") then choice = "research"
	elseif action_id == hash("key_3") then choice = "museum"
	elseif action_id == hash("key_4") then choice = "rocket" end

	if choice and self.near_lot then
		local lot = self.lots[self.near_lot]
		local b = BUILDINGS[choice]
		if self.counts[choice] >= b.limit then
			if b.limit == 1 then
				msg.post("/hud#hud", "show_dialogue", { text = b.name .. " already built! Only 1 allowed." })
			else
				msg.post("/hud#hud", "show_dialogue", { text = b.name .. " limit reached! Only " .. b.limit .. " allowed." })
			end
			return
		end
		if self.money >= b.cost then
			self.money = self.money - b.cost
			lot.building = choice
			lot.level = 1
			self.counts[choice] = self.counts[choice] + 1
			-- SPAWN AT REAL LOT POSITION, slightly above map so it's visible
			local spawn_pos = vmath.vector3(lot.pos.x, lot.pos.y, 0.5)
			lot.building_id = factory.create("#factory_" .. choice, spawn_pos)
			msg.post("/hud#hud", "show_dialogue", { text = b.name .. " BUILT! It now earns for you every second." })
		else
			msg.post("/hud#hud", "show_dialogue", { text = "Not enough money! Need " .. b.cost .. ", you have " .. math.floor(self.money) })
		end
		self.menu_open = false
	end
end

