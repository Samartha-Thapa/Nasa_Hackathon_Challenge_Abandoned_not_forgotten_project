end

function on_message_legacy(self, message_id, message, sender)
	if message_id == hash("player_entered_lot") then
		self.near_lot = message.lot
		self.menu_open = false
		local lot = self.lots[self.near_lot]
		if message.pos then lot.pos = message.pos end
		if lot.building == nil then
			msg.post("/hud#hud", "show_tutorial", {
				marker = self.near_lot == 1,
				shop = true,
				route = false,
				text = "Commander Hayes: This is Lot " .. self.near_lot .. ".\nClick the blinking OPEN SHOP button, then choose a building card."
			})
		elseif lot.building == "rocket" then
			msg.post("/hud#hud", "show_tutorial", {
				marker = false,
				shop = true,
				route = false,
				text = "Commander Hayes: Rocket systems are ready.\nClick OPEN SHOP to review upgrades."
			})
		else
			local b = BUILDINGS[lot.building]
			msg.post("/hud#hud", "show_tutorial", {
				marker = false,
				shop = true,
				route = false,
				text = "Commander Hayes: " .. b.name .. " is online at level " .. lot.level .. ".\nClick OPEN SHOP to review upgrades."
			})
		end
		return
	elseif message_id == hash("player_left_lot") then
		self.near_lot = nil
		self.menu_open = false
		self.mission_select = false
		msg.post("/store#store", "close_store")
		return
	elseif message_id == hash("try_interact") then
		if not self.near_lot then return end
		msg.post("/store#store", "open_store", {
			lot = self.near_lot,
			money = math.floor(self.money),
			science = math.floor(self.science)
		})
		msg.post("/hud#hud", "hide_dialogue")
		msg.post("/hud#hud", "hide_shop")
		self.menu_open = true
		return
	end
end

function on_message(self, message_id, message, sender)
	if message_id ~= hash("store_purchase") and message_id ~= hash("close_store") then
		return on_message_legacy(self, message_id, message, sender)
	elseif message_id == hash("store_purchase") then
			if not self.near_lot then
				send_store_result(self, "Move beside a construction lot first.")
				return
			end
			local lot = self.lots[self.near_lot]
			if message.category == "buildings" then
				if lot.building then
					send_store_result(self, "This lot already has " .. BUILDINGS[lot.building].name .. ".")
					return
				end
				local ok, text = build_item(self, message.item)
				send_store_result(self, text)
				if ok then
					self.menu_open = false
					msg.post("/store#store", "close_store")
					msg.post("/hud#hud", "hide_shop")
					msg.post("/hud#hud", "show_tutorial", {
						marker = false,
						shop = false,
						route = false,
						text = "Commander Hayes: Excellent work. The outpost is online.\nMove to the next empty lot when you are ready."
					})
				end
			elseif message.category == "upgrades" then
				if not lot.building then
					send_store_result(self, "Build a structure on this lot before upgrading it.")
					return
				end
				local b = BUILDINGS[lot.building]
				local cost = math.floor(b.cost * 1.5 * lot.level)
				if self.money < cost then
					send_store_result(self, "Need " .. cost .. " coins for this upgrade.")
					return
				end
				self.money = self.money - cost
				lot.level = lot.level + 1
				if lot.building_id then msg.post(lot.building_id, "upgrade", { level = lot.level }) end
				send_store_result(self, b.name .. " upgraded to level " .. lot.level .. ".")
			elseif message.category == "resources" then
				local costs = { ship_1 = 300, ship_2 = 450, ship_3 = 600 }
				local cost = costs[message.item]
				if not cost then
					send_store_result(self, "Resource unavailable.")
					return
				end
				if self.money < cost then
					send_store_result(self, "Need " .. cost .. " coins for this resource.")
					return
				end
				self.money = self.money - cost
				self.inventory[message.item] = (self.inventory[message.item] or 0) + 1
				send_store_result(self, "Resource added to the construction inventory.")
			end
		elseif message_id == hash("close_store") then
			self.menu_open = false
	end
end

function on_input(self, action_id, action)
	if self.launching then return end
	if not action.pressed then return end

	-- MISSION SELECT MODE: 1 = Moon, 2 = Mars
	if self.mission_select then
		local mission_key = nil
		if action_id == hash("key_1") then mission_key = "moon"
		elseif action_id == hash("key_2") then mission_key = "mars" end
		if mission_key then
			local m = MISSIONS[mission_key]
			if self.money >= m.money and self.science >= m.science then
				self.money = self.money - m.money
				self.science = self.science - m.science
				msg.post("/hud#hud", "update_money", { money = math.floor(self.money), science = math.floor(self.science) })
				self.mission_select = false
				self.menu_open = false
				self.launching = true
				self.launch_timer = 0
				self.pending_destination = m.name
				msg.post("/hud#hud", "show_launch", { destination = m.name })
			else
				msg.post("/hud#hud", "show_dialogue", { text = "Need " .. m.money .. " Money + " .. m.science .. " Science for " .. m.name .. "! You have " .. math.floor(self.money) .. " / " .. math.floor(self.science) })
			end
		end
		return
	end
end

